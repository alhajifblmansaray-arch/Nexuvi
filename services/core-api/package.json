{
  "name": "@nexuvi/core-api",
  "version": "0.0.0",
  "description": "Nexuvi modular monolith: tenant hierarchy, clinical workflows, orders/results, billing, pharmacy, hospital ops",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "type": "module",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "start": "node dist/main.js",
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import @swc-node/register/esm-register --test 'src/**/*.test.ts'",
    "test:db": "tsx scripts/test-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "start:dev": "node --import @swc-node/register/esm-register src/main.ts",
    "provision": "node --import @swc-node/register/esm-register scripts/provision.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nexuvi/api-contracts": "workspace:*",
    "@nexuvi/design-system": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "typeorm": "^0.3.19"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.17.0",
    "typescript": "^5.7.2"
  }
}
